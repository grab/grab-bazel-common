+  public FieldInitializers withNonZeroPlaceholderIds() {
+    final Map<ResourceType, Collection<FieldInitializer>> rewritten =
+        new EnumMap<>(ResourceType.class);
+
+    for (Map.Entry<ResourceType, Collection<FieldInitializer>> entry : initializers.entrySet()) {
+      ImmutableList.Builder<FieldInitializer> fields = ImmutableList.builder();
+      int fieldIndex = 1;
+      for (FieldInitializer initializer : entry.getValue()) {
+        if (initializer instanceof IntFieldInitializer
+            && ((IntFieldInitializer) initializer).getValue() == 0) {
+          int placeholderValue =
+              0x7f000000 | ((entry.getKey().ordinal() + 1) << 16) | (fieldIndex & 0xffff);
+          fields.add(((IntFieldInitializer) initializer).withValue(placeholderValue));
+        } else {
+          fields.add(initializer);
+        }
+        fieldIndex++;
+      }
+      rewritten.put(entry.getKey(), fields.build());
+    }
+
+    return copyOf(rewritten);
+  }
