+      writer.write("public final class R {\n");
+      for (Map.Entry<String, java.util.List<String>> entry : typeToChunkClasses.entrySet()) {
+        String typeName = entry.getKey();
+        java.util.List<String> chunks = entry.getValue();
+        // Extend the last chunk — it inherits all fields from the chain
+        String lastChunk = chunks.get(chunks.size() - 1);
+        writer.write(String.format("    public static final class %s extends %s {}\n", typeName, lastChunk));
+      }
+      writer.write("}\n");
