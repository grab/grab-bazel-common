+      String typeName = entry.getKey().getName();
+      java.util.List<FieldInitializer> fields = new java.util.ArrayList<>(entry.getValue());
+      java.util.List<String> chunkClasses = new java.util.ArrayList<>();
+
+      if (fields.size() <= MAX_FIELDS_PER_CLASS) {
+        // Single class for this type
+        String className = "R_" + typeName;
+        chunkClasses.add(className);
+        Path javaFile = packagePath.resolve(className + ".java");
+        try (java.io.BufferedWriter writer = java.nio.file.Files.newBufferedWriter(javaFile, java.nio.charset.StandardCharsets.UTF_8)) {
+          writer.write(String.format("package %s;\n", packageName));
+          writer.write(String.format("public class %s {\n", className));
+          for (FieldInitializer fieldInit : fields) {
+            fieldInit.writeInitSource(writer, finalFields);
+          }
+          writer.write("}\n");
+        }
+      } else {
+        // Split into chunks
+        int chunkIndex = 0;
+        for (int i = 0; i < fields.size(); i += MAX_FIELDS_PER_CLASS) {
+          int end = Math.min(i + MAX_FIELDS_PER_CLASS, fields.size());
+          String className = "R_" + typeName + "_" + chunkIndex;
+          chunkClasses.add(className);
+          Path javaFile = packagePath.resolve(className + ".java");
+          try (java.io.BufferedWriter writer = java.nio.file.Files.newBufferedWriter(javaFile, java.nio.charset.StandardCharsets.UTF_8)) {
+            writer.write(String.format("package %s;\n", packageName));
+            if (chunkIndex == 0) {
+              // First chunk is the base class
+              writer.write(String.format("public class %s {\n", className));
+            } else {
+              // Subsequent chunks extend the previous one (inheritance chain)
+              String prevClassName = "R_" + typeName + "_" + (chunkIndex - 1);
+              writer.write(String.format("public class %s extends %s {\n", className, prevClassName));
+            }
+            for (int j = i; j < end; j++) {
+              fields.get(j).writeInitSource(writer, finalFields);
+            }
+            writer.write("}\n");
+          }
+          chunkIndex++;
+        }
+      }
+      typeToChunkClasses.put(typeName, chunkClasses);
+    }
+
+    // Write R.java — each inner class extends the last chunk (which
+    // inherits all previous chunks via the chain)
+    Path rJavaFile = packagePath.resolve("R.java");
+    try (java.io.BufferedWriter writer = java.nio.file.Files.newBufferedWriter(rJavaFile, java.nio.charset.StandardCharsets.UTF_8)) {
