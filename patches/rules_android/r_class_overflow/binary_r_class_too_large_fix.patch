+  /**
+   * Writes separate .java files for each R inner class to avoid the 64K
+   * constant pool limit. Produces:
+   *   R.java       - outer class with inner class references
+   *   R_id.java    - public class with id fields (not an inner class)
+   *   R_string.java - public class with string fields
+   *   etc.
+   *
+   * The R.java outer class has:
+   *   public static final class id extends R_id {}
+   * This way existing code referencing R.id.field_name still works —
+   * the field is inherited from R_id.
+   */
+  private static void writeSplitRJava(
+      String packageName,
+      Path srcDir,
+      FieldInitializers allValues,
+      boolean finalFields)
+      throws IOException {
+    String packageDir = packageName.replace('.', '/');
+    Path packagePath = srcDir.resolve(packageDir);
+    java.nio.file.Files.createDirectories(packagePath);
+
+    // Collect resource types that have entries
+    java.util.List<Map.Entry<com.android.resources.ResourceType, Collection<FieldInitializer>>>
+        entries = new java.util.ArrayList<>();
+    for (Map.Entry<com.android.resources.ResourceType, Collection<FieldInitializer>> entry : allValues) {
+      entries.add(entry);
+    }
+
+    // Max fields per class to stay under 64K constant pool limit.
+    // Each field needs ~3-5 constant pool entries; 10000 fields ≈ 40K entries.
+    int MAX_FIELDS_PER_CLASS = 10000;
+
+    // Write split files per resource type, chunking large types
+    java.util.Map<String, java.util.List<String>> typeToChunkClasses = new java.util.LinkedHashMap<>();
