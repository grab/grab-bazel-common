+def _extract_data_binding(ctx, aar, unzip_tool):
+    """Extracts the data-binding directory from an AAR if present.
+
+    AARs compiled with data binding contain a 'data-binding/' directory with
+    setter_store.json and br.bin files. These need to be propagated via
+    DataBindingV2Info so that consuming android_library targets can find
+    binding adapters (e.g. android:onClick -> setOnClickListener).
+    """
+    data_binding_dir = _create_aar_tree_artifact(ctx, "data-binding")
+    ctx.actions.run_shell(
+        tools = [unzip_tool],
+        inputs = [aar],
+        outputs = [data_binding_dir],
+        command = """
+            mkdir -p {out_dir}
+            if {unzip} -l {aar} | grep -q 'data-binding/'; then
+                {unzip} -q -j {aar} 'data-binding/*' -d {out_dir} 2>/dev/null || true
+            fi
+        """.format(
+            unzip = unzip_tool.executable.path,
+            aar = aar.path,
+            out_dir = data_binding_dir.path,
+        ),
+        mnemonic = "AarDataBindingExtractor",
+        progress_message = "Extracting data-binding info from %s" % aar.basename,
+        toolchain = ANDROID_TOOLCHAIN_TYPE,
+    )
+    return data_binding_dir
+
+def _extract_db_package(ctx, aar, unzip_tool):
+    """Extracts the Java package from an AAR's AndroidManifest.xml for data binding mapper registration."""
+    pkg_file = create_aar_artifact(ctx, "db_package.txt")
+    ctx.actions.run_shell(
+        tools = [unzip_tool],
+        inputs = [aar],
+        outputs = [pkg_file],
+        command = """
+            if {unzip} -l {aar} 2>/dev/null | grep -q 'data-binding/'; then
+                {unzip} -p {aar} AndroidManifest.xml 2>/dev/null | sed -n 's/.*package="\\([^"]*\\)".*/\\1/p' | head -1 > {out}
+            fi
+            [ -s {out} ] || touch {out}
+        """.format(
+            unzip = unzip_tool.executable.path,
+            aar = aar.path,
+            out = pkg_file.path,
+        ),
+        mnemonic = "AarDataBindingPkgExtract",
+        progress_message = "Extracting data-binding package from %s" % aar.basename,
+        toolchain = ANDROID_TOOLCHAIN_TYPE,
+    )
+    return pkg_file
+
 def _extract_resources(
