+# Shell script to generate the synthetic AAR DataBinderMapperImpl.
+# This class uses reflection to load DataBinderMapperImpl from each AAR
+# that has data binding, allowing the MergedDataBinderMapper to discover
+# them via the collectDependencies() chain.
+_AAR_MAPPER_GEN_CMD = """\
+OUT="$1"; shift
+cat > "$OUT" << 'JAVAHEADER'
+package com.databinding.aar;
+
+import androidx.databinding.DataBinderMapper;
+import androidx.databinding.DataBindingComponent;
+import androidx.databinding.ViewDataBinding;
+import android.view.View;
+import java.util.List;
+import java.util.ArrayList;
+
+public class DataBinderMapperImpl extends DataBinderMapper {
+    @Override
+    public List<DataBinderMapper> collectDependencies() {
+        ArrayList<DataBinderMapper> result = new ArrayList<>();
+JAVAHEADER
+for f in "$@"; do
+    if [ -s "$f" ]; then
+        pkg=$(cat "$f")
+        if [ -n "$pkg" ]; then
+            printf '        try { result.add((DataBinderMapper) Class.forName("%s.DataBinderMapperImpl").getDeclaredConstructor().newInstance()); } catch (Exception e) {}\\n' "$pkg" >> "$OUT"
+        fi
+    fi
+done
+cat >> "$OUT" << 'JAVAFOOTER'
+        return result;
+    }
+    @Override
+    public ViewDataBinding getDataBinder(DataBindingComponent c, View v, int id) { return null; }
+    @Override
+    public ViewDataBinding getDataBinder(DataBindingComponent c, View[] v, int id) { return null; }
+    @Override
+    public int getLayoutId(String tag) { return 0; }
+    @Override
+    public String convertBrIdToString(int id) { return null; }
+}
+JAVAFOOTER
+"""
+
+def _generate_aar_mapper_source(ctx, output_dir, deps):
+    """Generate a synthetic DataBinderMapperImpl for AAR data binding packages."""
+    pkg_files = []
+    for info in deps:
+        pkg_files.extend(getattr(info, "db_package_files", depset()).to_list())
+    if not pkg_files:
+        return None
+    aar_mapper_src = ctx.actions.declare_file(
+        output_dir + "aar_mapper/DataBinderMapperImpl.java",
+    )
+    args = ctx.actions.args()
+    args.add(aar_mapper_src)
+    args.add_all(pkg_files)
+    ctx.actions.run_shell(
+        inputs = pkg_files,
+        outputs = [aar_mapper_src],
+        arguments = [args],
+        command = _AAR_MAPPER_GEN_CMD,
+        mnemonic = "AarDataBindingMapperGen",
+        progress_message = "Generating AAR data binding mapper registrations",
+    )
+    return aar_mapper_src
+
 def _merge_lists(lists):
     merged = []
