+def ExtractFlattenedDatabinding(aar, output_databinding_dir):
+  """Extracts all data-binding metadata files from an `aar`, flattening names."""
+  aar_contains_no_databinding = True
+  output_databinding_dir_abs = os.path.abspath(output_databinding_dir)
+  for name in aar.namelist():
+    if name.startswith("data-binding/") and not name.endswith("/"):
+      WriteFileWithJunctions(
+          os.path.join(output_databinding_dir_abs, os.path.basename(name)),
+          aar.read(name))
+      aar_contains_no_databinding = False
+  if aar_contains_no_databinding:
+    EnsureDir(output_databinding_dir_abs)
+
+
+def ExtractDatabindingPackage(aar, output_package_file):
+  """Writes the AAR manifest package when data-binding metadata is present."""
+  package_name = b""
+  if any(name.startswith("data-binding/") for name in aar.namelist()):
+    try:
+      manifest = aar.read("AndroidManifest.xml").decode("utf-8", "ignore")
+      match = re.search(r'package="([^"]*)"', manifest)
+      if match:
+        package_name = match.group(1).encode("utf-8")
+    except KeyError:
+      package_name = b""
+  WriteFileWithJunctions(output_package_file, package_name)
+
+
+def EnsureDir(dirname):
+  if not os.path.exists(dirname):
+    os.makedirs(dirname)
+
+
