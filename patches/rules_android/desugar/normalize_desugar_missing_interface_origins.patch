@@ -131,6 +136,65 @@ public final class MetadataCollector implements DependencyCollector {
   private static final Comparator<? super DesugarDeps.InterfaceWithCompanion>
       interFaceWithCompanionComparator = Comparator.comparing(o -> o.getOrigin().getBinaryName());
 
+  public static String canonicalizeMissingInterfaceOrigin(String origin, String target) {
+    // missing_interface.origin is only used by SingleJar as the diagnostic example if the
+    // missing target or one of its supertypes carries default methods. The correctness check is
+    // keyed by target, and R8 can report the same target from different valid implementors across
+    // clean builds, so use the stable target itself as the diagnostic origin.
+    if (isKotlinRuntimeMissingInterface(target)) {
+      return target;
+    }
+
+    return target;
+  }
+
+  public static String canonicalizeMissingInterfaceOrigin(String origin) {
+    // missing_interface.origin is used for diagnostics. R8 can report the same missing interface
+    // from different local or synthetic implementation classes across clean builds. Collapse those
+    // generated suffixes so desugar dependency metadata stays deterministic.
+    int localClassStart = firstLocalClassSuffix(origin);
+    if (localClassStart != -1) {
+      return origin.substring(0, localClassStart);
+    }
+
+    int syntheticStart = origin.indexOf("$$ExternalSynthetic");
+    if (syntheticStart != -1) {
+      return origin.substring(0, syntheticStart);
+    }
+
+    return origin;
+  }
+
+  private static boolean isKotlinRuntimeMissingInterface(String target) {
+    return target.equals("kotlin/jvm/internal/Lambda")
+        || target.startsWith("kotlin/jvm/functions/Function");
+  }
+
+  private static int firstLocalClassSuffix(String origin) {
+    for (int i = 0; i < origin.length() - 1; i++) {
+      if (origin.charAt(i) == '$' && Character.isDigit(origin.charAt(i + 1))) {
+        return i;
+      }
+    }
+    return -1;
+  }
+
+  private static void dedupeSortedDependencies(ArrayList<DesugarDeps.Dependency> dependencies) {
+    if (dependencies.size() < 2) {
+      return;
+    }
+    int writeIndex = 1;
+    DesugarDeps.Dependency previous = dependencies.get(0);
+    for (int readIndex = 1; readIndex < dependencies.size(); readIndex++) {
+      DesugarDeps.Dependency current = dependencies.get(readIndex);
+      if (!current.equals(previous)) {
+        dependencies.set(writeIndex++, current);
+        previous = current;
+      }
+    }
+    dependencies.subList(writeIndex, dependencies.size()).clear();
+  }
+
   private static DesugarDeps.Type wrapType(String internalName) {
     return DesugarDeps.Type.newBuilder().setBinaryName(internalName).build();
   }
