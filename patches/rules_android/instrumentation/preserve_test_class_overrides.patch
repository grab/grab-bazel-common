diff --git a/rules/android_binary/impl.bzl b/rules/android_binary/impl.bzl
--- a/rules/android_binary/impl.bzl
+++ b/rules/android_binary/impl.bzl
@@ -546,6 +546,24 @@
             # These files are generated by databinding in both the target and the instrumentation
             # app with different contents. We want to keep the one from the target app.
-            filters = ["/BR\\.class$", "/databinding/[^/]+Binding\\.class$"],
+            filters = [
+                "/BR\\.class$",
+                "/databinding/[^/]+Binding\\.class$",
+                # Bazel 7 defaulted
+                # --experimental_remove_r_classes_from_instrumentation_test_jar=true, removing
+                # instrumentation-side R classes even when hash-mismatched test overrides are
+                # kept. Keep that behavior to avoid duplicate generated R classes in the app and
+                # instrumentation APK classloaders.
+                "(^|/)R\\.class$",
+                "(^|/)R\\$.*\\.class$",
+                # grab_bazel_common's R-class overflow patches can emit sharded classes such as
+                # R_drawable_0.class and R_string_2.class. Bazel 7 did not ship these from the
+                # instrumentation APK either, so filter them with the rest of the R classes.
+                "(^|/)R_[^/]+_[0-9]+\\.class$",
+            ],
+            # Match Bazel 7's ZipFilterAction WARN mode so same-FQN test-side
+            # class overrides (different crc, same name) survive into the
+            # instrumentation APK instead of being stripped.
+            check_hash_mismatch = "WARN",
         )
         deploy_jar = filtered_deploy_jar

diff --git a/rules/common.bzl b/rules/common.bzl
--- a/rules/common.bzl
+++ b/rules/common.bzl
@@ -99,10 +99,17 @@
     if filters:
         args.add("--explicitFilters", ",".join(filters))

-    if check_hash_mismatch:
+    # Accepts True/False (legacy: maps to ERROR/IGNORE) or one of the literal strings
+    # "IGNORE", "WARN", "ERROR". WARN preserves Bazel 7's ZipFilterAction behavior of
+    # keeping hash-mismatched entries (different bytecode, same FQN) in the output zip,
+    # which is needed for android_binary(instruments = ...) to keep same-FQN test-side
+    # class overrides in the instrumentation APK.
+    if check_hash_mismatch == True:
         args.add("--checkHashMismatch", "ERROR")
-    else:
+    elif check_hash_mismatch == False:
         args.add("--checkHashMismatch", "IGNORE")
+    else:
+        args.add("--checkHashMismatch", check_hash_mismatch)

     args.add("--outputMode", compression_mode)

